# Variables de Entorno para MASSIVE
# Copiar este archivo a .env y configurar los valores reales

# Zapier MCP Token (OBTENER DE ZAPIER.COM)
# IR A: https://developer.zapier.com/mcp
ZAPIER_MCP_TOKEN=tu_token_aqui

# Otros tokens y configuraciones sensibles
# API_KEY=tu_api_key
# DATABASE_URL=postgresql://user:pass@localhost/db


# ── MASSIVE UI-NG (interfaz de nueva generación) ──
# Backend FastAPI + frontend React (ver docs/NEXT_GEN_UI_PRODUCTION_ES.md)
PROVIDER=groq                    # groq | openai | openrouter | ollama
GROQ_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.2
MASSIVE_API_KEYS=                # API key(s) separadas por coma (vacío = modo dev abierto)
MASSIVE_ALLOWED_HOSTS=*          # host(s) permitidos en producción
MASSIVE_RATE_LIMIT_PER_MIN=120
MASSIVE_RATE_LIMIT_SIMULATE_PER_MIN=12
MASSIVE_DATA_DIR=data/ui_ng     # persistencia SQLite de corridas
MASSIVE_SERVE_FRONTEND=1         # servir el frontend compilado desde el backend
