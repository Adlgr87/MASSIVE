# Backup files
.env.backup

# AionRS session data
.aionrs/

# Python cache
__pycache__/
*.pyc
*.pyo

# Reports generados en runtime
reports/validation/run_*/
reports/benchmarks/baseline_v*/

# Runtime artifacts (no commit)
landscapes_cache.db
massive_run.log
*.log
.coverage
htmlcov/
.mypy_cache/
.pytest_cache/

# Local Factbook dumps (prefer fixtures under tests/ or data/factbook/*.example)
data/factbook/*_raw.json
data/factbook/*_test.json
!data/factbook/.gitkeep

# Runtime SQLite DBs (ui_ng, etc.)
data/ui_ng/*.db
data/ui_ng/*.db-shm
data/ui_ng/*.db-wal
data/ui_ng/.gitkeep

# SOTA roadmap artifacts (regenerated on each run)
reports/sota_v0_seed*/

# Generated site files
/site/

# Validation reports
reports/validation/local/
/target/

# Generated frontend build artifacts
# `frontend/dist` is a symlink to massive-ui-ng/frontend/dist (build output).
# Do not commit build outputs; they are regenerated via `npm run build`.
frontend/dist
frontend/dist/
massive-ui-ng/frontend/dist/
