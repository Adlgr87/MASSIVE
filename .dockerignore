# Git
.git
.gitignore

# Python cache
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
*.egg-info/

# Virtual environments
.venv/
venv/

# Dependencies (huge)
frontend/node_modules/
massive-ui-ng/frontend/node_modules/

# Frontend build output (symlink in some configs — built inside container)
frontend/dist

# Data and models (large binary files)
# NOTE: models/ is NOT excluded — CfC weights (models/cfc_calibrated/*.pt)
# must be present in the image. Only specific large sub-paths are excluded below.
data/
datasets/
results/
experiments/

# Env files (mounted at runtime, not baked in)
.env
.env.local

# CSV data files
*.csv

# Logs
*.log
logs/

# Reports (CI/LLM outputs are generated at runtime)
reports/validation/ci/
reports/validation/llm_run/

# IDE
.vscode/
.kilocode/

# Docs, CI, build outputs (not needed in runtime image)
docs/
.github/
site/
archive/

# Test data and outputs
tests/test_data/

# Environment / credential files
*.env
*.env.*.backup
