# =============================================================================
# MASSIVE Environment Variables
# Copy this file to .env and fill in your values.
# Full reference: PRODUCTION_ARCHITECTURE_SPEC.md §4.1
# =============================================================================

# ── Core application ─────────────────────────────────────────────────────────
MASSIVE_API_KEY=change-me-in-production   # Required in staging | production. No dev fallback when MASSIVE_ENV=production.
MASSIVE_ENV=development                    # development | staging | production
MASSIVE_CORS_ORIGINS=http://localhost:1234,http://localhost:3000
                                           # In production set to your UI domain(s), comma-separated (no wildcard with credentials)
MASSIVE_RATE_LIMIT_PER_MIN=60
MASSIVE_RATE_LIMIT_BACKEND=memory          # memory (single worker) | file (multi-worker)
MASSIVE_RATE_LIMIT_PATH=/tmp/massive_rate_limit.json  # used when backend=file
MASSIVE_MAX_UPLOAD_MB=10

# ── Logging ──────────────────────────────────────────────────────────────────
MASSIVE_LOG_FILE=                          # optional: e.g. /var/log/massive/app.log
PYTHONHASHSEED=42                          # for CI / reproducibility runs

# ── LLM Providers ────────────────────────────────────────────────────────────
PROVIDER=groq                             # default provider label used by /v1/llm/*
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
OLLAMA_HOST=http://localhost:11434         # optional, for local Ollama integration

# ── LLM run_simulation tuning (v0.2+) ─────────────────────────────────────────
MASSIVE_LLM_TIMEOUT_SECONDS=120
MASSIVE_LLM_MAX_RETRIES=3

# ── Social media seeding (optional) ─────────────────────────────────────────
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here

# ── Observabilidad (v0.3+) ──────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317  # OpenTelemetry collector endpoint
MASSIVE_SLO_ERROR_BUDGET=0.05                       # max 5% error rate target
MASSIVE_SLO_P95_LATENCY_MS=2000                     # p95 latency target (sim < 100 steps)

# ── Analytics snippet (optional, injected by deployment) ──────────────────────
MASSIVE_ANALYTICS_SNIPPET=
