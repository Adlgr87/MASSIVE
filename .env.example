# MASSIVE Environment Variables
# Copy this file to .env and fill in your API keys.

# Groq Cloud API Key (https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# OpenAI API Key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here

# OpenRouter API Key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Ollama Host (Optional, defaults to http://localhost:11434)
OLLAMA_HOST=http://localhost:11434

# Twitter/X Bearer Token (https://developer.twitter.com — Optional, for social media seeding)
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# Reddit API Credentials (https://www.reddit.com/prefs/apps — Optional, for social media seeding)
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here

# Optional raw HTML/JS analytics snippet injected by deployment environments.
# Leave empty for local/dev runs.
MASSIVE_ANALYTICS_SNIPPET=

# ─── UI-NG Backend (backend/app/settings.py) ───────────────────────
# MASSIVE_ENV: "development" | "staging" | "production"
MASSIVE_ENV=production
# Serve built Angular/Vite frontend from /app/frontend/dist
MASSIVE_SERVE_FRONTEND=1
# Directory for SQLite run storage (runs.db)
MASSIVE_DATA_DIR=/data

# API authentication — comma-separated keys (rotate regularly in production)
# MASSIVE API — set to a strong random token (no default placeholder!)
# Generate one with:  python -c "import secrets;print(secrets.token_urlsafe(32))"
MASSIVE_API_KEYS=REPLACE_WITH_GENERATED_KEY

# CORS — explicit origins only (never "*" with credentials)
MASSIVE_CORS_ORIGINS=https://massive.example.com

# Trusted hosts — comma-separated (use FQDN in production)
MASSIVE_ALLOWED_HOSTS=massive.example.com,127.0.0.1

# Logging (structured JSON when MASSIVE_LOG_FORMAT=json)
MASSIVE_LOG_LEVEL=INFO
MASSIVE_LOG_FORMAT=json

# LLM runtime tuning
MASSIVE_LLM_MODEL=llama-3.3-70b-versatile
MASSIVE_LLM_TIMEOUT=45
MASSIVE_LLM_MAX_TOKENS=1400

# LLM provider selection
PROVIDER=groq

# Observability backends (set when wiring Prometheus/Grafana)
MASSIVE_PROMETHEUS_MULTIHISTOGRAM=0
